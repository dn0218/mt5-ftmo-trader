# ── MT5 ──────────────────────────────
MT5_LOGIN=PLACEHOLDER
MT5_PASSWORD=PLACEHOLDER
MT5_SERVER=PLACEHOLDER

# ── LLM (OpenAI or Ollama) ───────────
LLM_PROVIDER=openai
LLM_ENABLED=true
LLM_TIMEOUT=30

# ── OpenAI (default — gpt-4o-mini ~$0.0003/call) ──
OPENAI_API_KEY=PLACEHOLDER
OPENAI_MODEL=gpt-4o-mini

# ── Ollama fallback (RTX 3050 4GB) ───
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT=60
OLLAMA_NUM_CTX=4096
OLLAMA_TEMPERATURE=0.1
OLLAMA_ENABLED=true

# ── Trading ──────────────────────────
SYMBOLS=EURUSD,XAUUSD
TIMEFRAME=M15
LOOKBACK_BARS=500
SCAN_INTERVAL_SECONDS=60
SESSION_KILL_ZONES=07:00-09:00,13:00-15:00

# ── FTMO Risk ────────────────────────
RISK_PER_TRADE=0.5
MAX_DAILY_DRAWDOWN=2.0
MAX_TOTAL_DRAWDOWN=6.0
MAX_SPREAD_POINTS=25
RISK_REWARD_MIN=2.0
MAX_CONCURRENT_POSITIONS=2
MAX_TRADES_PER_DAY=10
SL_COOLDOWN_SECONDS=3600
CONSECUTIVE_LOSS_HALT=3
MIN_CONFLUENCE_SCORE=3
MIN_CONFLUENCE_SCORE_HTF_ALIGNED=3
MIN_CONFLUENCE_SCORE_HTF_OPPOSED=4
MIN_LLM_CONFIDENCE=0.70
MIN_LLM_CONFIDENCE_HTF_OPPOSED=0.80
HTF_FILTER_MODE=soft
RSI_GATE_FOR_SCORE_3=true

# ── Per-symbol SL ────────────────────
MIN_SL_PIPS=15
MIN_SL_PIPS_EURUSD=15
MIN_SL_PIPS_XAUUSD=60
MAX_SL_PIPS=150
MAX_SL_PIPS_XAUUSD=300

# ── Trade Management ─────────────────
BE_TRIGGER_R=1.0
CLOSE_ON_INVALIDATION=true
TP1_CLOSE_PCT=50
TP2_CLOSE_PCT=30
EOS_BE_GUARD_MINUTES=30
HARD_RR_CAP=5.0
RR_FLOOR_SCORE_4=2.5
RR_FLOOR_SCORE_5=3.0
TRAIL_ENABLED=true
TRAIL_ATR_MULT=1.5
LLM_PLAN_TARGETS=false

# ── Session (UTC) ────────────────────
TRADING_START_UTC=07:00
TRADING_END_UTC=20:00

# ── Filters ──────────────────────────
NEWS_FILTER_ENABLED=true
NEWS_BLACKOUT_PRE_MINUTES=30
NEWS_BLACKOUT_POST_MINUTES=15
REGIME_FILTER_ENABLED=true
REGIME_ALLOW_RANGING=false
REGIME_ALLOW_VOLATILE=false
HTF_FILTER_ENABLED=true
HTF_TIMEFRAME=H4
HTF_LOOKBACK_BARS=200

# ── Precheck ─────────────────────────
PRECHECK_REQUIRE_BOS=true
PRECHECK_REQUIRE_CHOCH=true
PRECHECK_REQUIRE_SWEEP=true
PRECHECK_REQUIRE_STRONG_SWEEP=true
PRECHECK_MIN_CORE_SIGNALS=1
SWEEP_DIRECTION_FILTER_ENABLED=true

# ── Evidence ─────────────────────────
EVIDENCE_CANDLES_LIMIT=48
EVIDENCE_EVENTS_LIMIT=15
LLM_EVIDENCE_TOKEN_BUDGET=3000

# ── Execution ────────────────────────
EXECUTION_ENABLED=true
DRY_RUN=true
LLM_DECISION_DEBUG=true

# ── Telegram ─────────────────────────
TELEGRAM_BOT_TOKEN=PLACEHOLDER
TELEGRAM_CHAT_ID=PLACEHOLDER
TELEGRAM_ENABLED=true
